{
  "description": "watsonx.ai Configuration for Code Review",
  "version": "1.0",
  "api": {
    "base_url": "https://us-south.ml.cloud.ibm.com",
    "version": "2023-05-29",
    "timeout": 60,
    "retry_attempts": 3,
    "retry_delay": 5
  },
  "model": {
    "id": "ibm/granite-13b-chat-v2",
    "alternatives": [
      "ibm/granite-20b-code-instruct",
      "meta-llama/llama-2-70b-chat",
      "ibm/granite-34b-code-instruct"
    ],
    "parameters": {
      "decoding_method": "greedy",
      "max_new_tokens": 2000,
      "min_new_tokens": 100,
      "temperature": 0.3,
      "top_p": 0.9,
      "top_k": 50,
      "repetition_penalty": 1.1
    }
  },
  "review_settings": {
    "quick": {
      "description": "Fast review focusing on critical issues",
      "max_files": 5,
      "max_tokens": 1000,
      "focus_areas": ["security", "critical_bugs"]
    },
    "standard": {
      "description": "Balanced review covering quality, security, and best practices",
      "max_files": 10,
      "max_tokens": 2000,
      "focus_areas": ["security", "code_quality", "best_practices"]
    },
    "comprehensive": {
      "description": "Deep analysis including performance and architecture",
      "max_files": 20,
      "max_tokens": 3000,
      "focus_areas": ["security", "code_quality", "performance", "architecture", "maintainability"]
    }
  },
  "analysis_rules": {
    "security": {
      "enabled": true,
      "checks": [
        "hardcoded_credentials",
        "sql_injection",
        "xss_vulnerabilities",
        "insecure_dependencies",
        "weak_cryptography",
        "authentication_issues",
        "authorization_flaws"
      ]
    },
    "code_quality": {
      "enabled": true,
      "checks": [
        "code_complexity",
        "duplicate_code",
        "dead_code",
        "code_smells",
        "naming_conventions",
        "function_length",
        "class_size"
      ]
    },
    "best_practices": {
      "enabled": true,
      "checks": [
        "error_handling",
        "logging_practices",
        "documentation",
        "test_coverage",
        "design_patterns",
        "solid_principles"
      ]
    },
    "performance": {
      "enabled": true,
      "checks": [
        "inefficient_algorithms",
        "memory_leaks",
        "resource_management",
        "database_queries",
        "caching_opportunities"
      ]
    },
    "maintainability": {
      "enabled": true,
      "checks": [
        "code_readability",
        "modularity",
        "coupling",
        "cohesion",
        "technical_debt"
      ]
    }
  },
  "file_filters": {
    "include_patterns": [
      "*.java",
      "*.py",
      "*.js",
      "*.ts",
      "*.jsx",
      "*.tsx",
      "*.go",
      "*.rb",
      "*.php",
      "*.cs",
      "*.cpp",
      "*.c",
      "*.h"
    ],
    "exclude_patterns": [
      "*.min.js",
      "*.bundle.js",
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      "target/**",
      "*.test.js",
      "*.spec.js"
    ],
    "max_file_size_kb": 500
  },
  "scoring": {
    "weights": {
      "security": 0.4,
      "code_quality": 0.3,
      "maintainability": 0.2,
      "performance": 0.1
    },
    "severity_impact": {
      "critical": -30,
      "high": -15,
      "medium": -5,
      "low": -2
    }
  },
  "output": {
    "format": "json",
    "include_recommendations": true,
    "include_code_snippets": true,
    "max_issues_per_severity": 50,
    "group_by": "file"
  },
  "cache": {
    "enabled": true,
    "ttl_hours": 24,
    "cache_unchanged_files": true
  },
  "rate_limiting": {
    "max_requests_per_minute": 10,
    "max_tokens_per_request": 4000
  }
}